{
  "name": "dsh-boost",
  "version": "0.1.0",
  "description": "Cut DSH token usage by projecting tool receipts and skipping deterministic read-only calls. Install as dsh-boost@^0.1.0: the registry latest tag still points at the incompatible 0.0.1-rc.1.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": ["dsh", "dsh-plugin", "token-efficiency", "prompt-cache", "tool-receipt", "delegation"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "stats": "node scripts/session-stats.mjs",
    "ci": "npm run typecheck && npm test && npm run build",
    "verify:package": "node scripts/verify-package.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run ci && npm run verify:package"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.4",
    "@deepseek-ai/dsh-spill-policy": "0.2.2-rc.4",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=24.9.0", "dsh": ">=0.2.2-rc.1 <0.3.0-0" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "files": ["dist", "locale", "cordis.patch.yml", "README.md", "README.en.md", "LICENSE", "NOTICE"]
}