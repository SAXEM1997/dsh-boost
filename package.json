{
  "name": "dsh-boost",
  "version": "0.2.6",
  "description": "Cut DSH token usage by projecting tool receipts and substituting deterministic read-only calls.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAXEM1997/dsh-boost.git"
  },
  "homepage": "https://github.com/SAXEM1997/dsh-boost",
  "bugs": {
    "url": "https://github.com/SAXEM1997/dsh-boost/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "token-efficiency",
    "prompt-cache",
    "tool-receipt",
    "delegation"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./lib/client.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.client.json",
    "test": "node scripts/run-tests.mjs",
    "stats": "node scripts/session-stats.mjs",
    "ci": "npm run typecheck && npm test && npm run build",
    "verify:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run ci && npm run verify:package -- --prebuilt",
    "prepare": "node scripts/prepare-build.mjs",
    "build:client": "vite build --config ui/vite.config.ts --mode client",
    "dev:ui": "vite --config ui/vite.config.ts"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4",
    "@deepseek-ai/dsh-spill-policy": "0.2.2-rc.4",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.4",
    "@types/node": "^24",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "js-yaml": "^4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.8"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.4 <0.2.3-0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "dist",
    "!dist/**/*.d.ts",
    "dist/index.d.ts",
    "dist/types.d.ts",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE"
  ]
}
